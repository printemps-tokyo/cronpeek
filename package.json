{
  "name": "@printemps-tokyo/cronpeek",
  "version": "0.1.0",
  "description": "Explain a cron expression and show its next run times. Zero-dependency CLI.",
  "type": "module",
  "license": "MIT",
  "author": "printemps.tokyo <develop@printemps.tokyo>",
  "homepage": "https://github.com/printemps-tokyo/cronpeek#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/printemps-tokyo/cronpeek.git"
  },
  "bugs": {
    "url": "https://github.com/printemps-tokyo/cronpeek/issues"
  },
  "keywords": [
    "cron",
    "crontab",
    "schedule",
    "next-run",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cronpeek": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
